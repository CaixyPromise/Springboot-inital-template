<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 基于 converter -->
    <conversionRule conversionWord="sensitive" converterClass="com.github.houbb.sensitive.logback.converter.SensitiveLogbackConverter" />

    <springProperty scope="context" name="app.name" source="spring.application.name"/>
    <springProperty scope="context" name="log.location" source="logging.file-location" default="./logs"/>

    <property name="APP_NAME" value="${app.name}"/>
    <property name="LOG_PATH" value="${log.location}/${APP_NAME}/logs"/>
    <property name="LOG_FILE" value="${LOG_PATH}/application.log"/>
    <property name="FILE_LOG_PATTERN" value="%d %-5level [%thread %logger - %sensitive%n"/>

    <appender name="APPLICATION"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %sensitive%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxHistory>7</maxHistory>
            <maxFileSize>50MB</maxFileSize>
            <totalSizeCap>20GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>utf8</charset>
        </encoder>
    </appender>

    <!-- Log Level Control -->
    <root level="INFO">
        <!-- Use <springProfile> to differentiate environments -->

        <!-- Production environment: Only log to file -->
        <springProfile name="prod">
            <appender-ref ref="APPLICATION"/>
        </springProfile>

        <!-- Development environment: Log to both file and console -->
        <springProfile name="dev">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="APPLICATION"/>
        </springProfile>

        <!-- Test environment: Log to both file and console -->
        <springProfile name="test">
            <appender-ref ref="APPLICATION"/>
            <appender-ref ref="CONSOLE"/>
        </springProfile>

    </root>
</configuration>